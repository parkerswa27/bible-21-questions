# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Required for the AI fallback (server/ai_fallback.py). Without this set, the game
# still works fully — questions the rule engine can't parse just get a friendly
# "I didn't understand that" instead of an AI-backed answer.
# Get a key at https://console.anthropic.com/
AI_API_KEY=

# Optional: which Claude model to use for the AI fallback. Defaults to a fast,
# inexpensive model if unset — this task is a simple 4-way classification, no need
# for a larger model.
AI_MODEL=claude-haiku-4-5-20251001

# Optional: port the Flask server listens on locally (most hosts set this for you
# automatically in production).
PORT=8778

# Optional: set to 1 for Flask's debug/auto-reload mode during local development.
# Never enable this in production.
FLASK_DEBUG=0
